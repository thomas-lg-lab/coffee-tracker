{
  "name": "coffee-tracker",
  // Build the dev image from .devcontainer/Dockerfile. Paths are relative to
  // THIS file: "Dockerfile" => .devcontainer/Dockerfile; ".." => repo root,
  // so the build context is the whole workspace.
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "features": {
    // Node 24 (LTS) + npm, layered on top of the .NET 10 SDK base image. Keep the
    // version in step with the Dockerfile and ci.yml.
    "ghcr.io/devcontainers/features/node:2": { "version": "26.13.1" },
    // Claude Code CLI (npm-based, so it needs the Node feature above).
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // GitHub CLI (`gh`). Auth comes from the GH_TOKEN env var below, gh picks it
    // up automatically, so no `gh auth login` is needed inside the container.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Reuse the host's Claude Code credentials so the CLI is logged in inside the
  // container without re-running OAuth on every rebuild.
  //
  // HOME is set on macOS/Linux and USERPROFILE on Windows, never both, so concatenating
  // them yields whichever exists, a bare ${localEnv:USERPROFILE} resolves to empty off
  // Windows and silently binds /.claude instead.
  //
  // This hands host credentials to a container that builds npm and NuGet dependency
  // trees, so an install script runs with reach into them. Drop this line to log in
  // interactively inside the container instead.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],
  // This container ships both OCR engines (see .devcontainer/Dockerfile), so turn the
  // real one on here. Overrides appsettings.Development.json's Ocr:Engine=none; that
  // exists only so the bare macOS host (no engine at all) doesn't 503 on /scan.
  //
  // rapidocr, matching what production starts with, so what gets exercised here is what
  // users actually scan through. It is only the starting default either way: an
  // administrator's choice in Admin -> Scanning is stored and wins over this.
  "containerEnv": {
    "Ocr__Engine": "rapidocr"
  },
  // GitHub auth for `gh` and `git push` over HTTPS. The value is read from the
  // HOST environment at attach time (${localEnv:...}) and is NEVER stored in this
  // file or the image, set GH_TOKEN on your machine to a GitHub PAT. If GH_TOKEN
  // is unset on the host this resolves to empty and gh just stays logged out.
  // remoteEnv (not containerEnv) keeps the secret at the tooling layer, out of
  // `docker inspect`. post-create.sh wires it into git's credential helper.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  // Dev runs the API HTTP-only on localhost:5000 and ng serve on 4200. No HTTPS in the
  // container: http://localhost is already a secure context, so the PWA service worker
  // and the camera work without a certificate.
  "forwardPorts": [5000, 4200],
  // Runs once from the workspace root after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "Angular.ng-template",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "dotnet.defaultSolution": "CoffeeTracker.sln"
      }
    }
  },
  "remoteUser": "vscode"
}
